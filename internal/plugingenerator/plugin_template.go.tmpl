// {{$plugin}}Aggregate manages {{$entity.Name}} state
type {{$plugin}}Aggregate struct {
    {{$entity.Name}}s map[string]*{{$entity.Name}}
    commands map[string]eventsourcing.CommandHandler
    Mu       sync.RWMutex
}

// New{{$plugin}}Aggregate creates a new aggregate instance
func New{{$plugin}}Aggregate() *{{$plugin}}Aggregate {
    return &{{$plugin}}Aggregate{
        {{$entity.Name}}s: make(map[string]*{{$entity.Name}}),
        commands: make(map[string]eventsourcing.CommandHandler),
    }
}

func (a *{{$plugin}}Aggregate) ID() string {
    return "{{$plugin}}"
}

func (a *{{$plugin}}Aggregate) ApplyEvent(event eventsourcing.Event) error {
    a.Mu.Lock()
    defer a.Mu.Unlock()

    switch e := event.(type) {
    case *{{$entity.Name}}CreatedEvent:
        a.{{$entity.Name}}s[e.{{$entityID}}] = &{{$entity.Name}}{
{{- range $entity.Fields }}
            {{ .Name }}: e.{{ .Name }},
{{- end }}
            CreatedAt: time.Now().UTC(),
        }
    case *{{$entity.Name}}UpdatedEvent:
        if item, ok := a.{{$entity.Name}}s[e.{{$entityID}}]; ok {
{{- range $entity.Fields }}
            item.{{ .Name }} = e.{{ .Name }}
{{- end }}
        }
    case *{{$entity.Name}}DeletedEvent:
        delete(a.{{$entity.Name}}s, e.{{$entityID}})
    case *{{$entity.Name}}sListedEvent:
        for _, item := range e.{{$entity.Name}}s {
            clone := *item
            a.{{$entity.Name}}s[item.{{$entityID}}] = &clone
        }
    }
    return nil
}

func (a *{{$plugin}}Aggregate) EmitDelta(event eventsourcing.Event) *eventsourcing.DeltaEnvelope {
    var actions []eventsourcing.DeltaAction
    switch event.(type) {
    case *{{$entity.Name}}sListedEvent:
        actions = a.GetFull3DState()
    default:
        actions = a.Broadcast3DDelta(event)
    }
    if len(actions) == 0 {
        return nil
    }
    return &eventsourcing.DeltaEnvelope{
        Type:       "delta",
        Aggregate:  a.ID(),
        EventID:    fmt.Sprintf("%s-%d", event.Type(), time.Now().UnixNano()),
        Timestamp:  eventsourcing.ISOTimestamp(),
        SequenceID: eventsourcing.NextSequenceID(),
        Actions:    actions,
    }
}

func (a *{{$plugin}}Aggregate) Reset() {
    a.Mu.Lock()
    defer a.Mu.Unlock()
    a.{{$entity.Name}}s = make(map[string]*{{$entity.Name}})
}

// {{$plugin}}Plugin implements the plugin interface
type {{$plugin}}Plugin struct {
    aggregate *{{$plugin}}Aggregate
}

func NewPlugin() eventsourcing.Plugin {
    agg := New{{$plugin}}Aggregate()
    p := &{{$plugin}}Plugin{aggregate: agg}
    agg.commands = map[string]eventsourcing.CommandHandler{
{{- range $req.Commands }}
        "{{ .Name }}": eventsourcing.NewCommand(func(input *{{ .Name }}Input) ([]eventsourcing.Event, error) {
            return p.{{ lower .Name }}Handler(input)
        }),
{{- end }}
    }
    eventsourcing.RegisterEvent("{{$req.Name}}_{{$entity.Name}}Created", func() eventsourcing.Event { return &{{$entity.Name}}CreatedEvent{} })
    eventsourcing.RegisterEvent("{{$req.Name}}_{{$entity.Name}}Updated", func() eventsourcing.Event { return &{{$entity.Name}}UpdatedEvent{} })
    eventsourcing.RegisterEvent("{{$req.Name}}_{{$entity.Name}}sListed", func() eventsourcing.Event { return &{{$entity.Name}}sListedEvent{} })
    eventsourcing.RegisterEvent("{{$req.Name}}_{{$entity.Name}}Deleted", func() eventsourcing.Event { return &{{$entity.Name}}DeletedEvent{} })
    return p
}

func (p *{{$plugin}}Plugin) Commands() map[string]eventsourcing.CommandHandler {
    return p.aggregate.commands
}

func (p *{{$plugin}}Plugin) Name() string {
    return "{{$req.Name}}"
}

func (p *{{$plugin}}Plugin) Schemas() map[string]eventsourcing.CommandInput {
    return map[string]eventsourcing.CommandInput{
{{- range $req.Commands }}
        "{{ .Name }}": &{{ .Name }}Input{},
{{- end }}
    }
}

{{- range $req.Commands }}
func (i *{{ .Name }}Input) New() any {
    return &{{ .Name }}Input{}
}

type {{ .Name }}Input struct {
{{- range .Input }}
    {{ .Name }} {{ .Type }} `json:"{{ .JSON }}"`
{{- end }}
}

func (i *{{ .Name }}Input) Schema() map[string]interface{} {
    schema := map[string]interface{}{
        "description": "{{ .Name }} command input",
        "parameters": map[string]interface{}{
            "type": "object",
            "properties": map[string]interface{}{
{{- range .Input }}
                "{{ .JSON }}": map[string]interface{}{
                    "type": "{{ schemaType .Type }}",
                    "description": "{{ .Name }}",
                },
{{- end }}
            },
        },
    }
{{- if gt (len .Input) 0 }}
    schema["parameters"].(map[string]interface{})["required"] = []string{
{{- range .Input }}
        "{{ .JSON }}",
{{- end }}
    }
{{- else }}
    schema["parameters"].(map[string]interface{})["required"] = []string{}
{{- end }}
    return schema
}
{{- end }}

