func (a *{{$plugin}}Aggregate) Broadcast3DDelta(event eventsourcing.Event) []eventsourcing.DeltaAction {
    switch e := event.(type) {
    case *{{$entity.Name}}CreatedEvent:
        return []eventsourcing.DeltaAction{ {
            Type:     "create",
            NodeID:   e.{{$entityID}},
            NodeType: "MeshInstance3D",
            Properties: map[string]interface{}{
                "mesh":     "box",
                "position": {{ randomPos }},
                "material_override": map[string]interface{}{
                    "albedo_color": []float64{0.8, 0.8, 0.8, 1.0},
                },
            },
            Metadata: map[string]interface{}{
                "id": e.{{$entityID}},
            },
        }}
    case *{{$entity.Name}}DeletedEvent:
        return []eventsourcing.DeltaAction{ {
            Type:   "delete",
            NodeID: e.{{$entityID}},
        }}
    }
    return nil
}

func (a *{{$plugin}}Aggregate) GetFull3DState() []eventsourcing.DeltaAction {
    a.Mu.RLock()
    defer a.Mu.RUnlock()
    actions := make([]eventsourcing.DeltaAction, 0, len(a.{{$entity.Name}}s))
    i := 0
    for id := range a.{{$entity.Name}}s {
        pos := ui3d.PositionInCircle(i, 6.0+float64(i)*0.5, 2.0)
        actions = append(actions, eventsourcing.DeltaAction{
            Type:     "create",
            NodeID:   id,
            NodeType: "MeshInstance3D",
            Properties: map[string]interface{}{
                "mesh":     "box",
                "position": pos,
                "material_override": map[string]interface{}{
                    "albedo_color": []float64{0.8, 0.8, 0.8, 1.0},
                },
            },
            Metadata: map[string]interface{}{
                "id": id,
            },
        })
        i++
    }
    return actions
}

