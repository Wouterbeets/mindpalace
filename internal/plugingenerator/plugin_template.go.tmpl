func generate{{$entity.Name}}ID() string {
    return fmt.Sprintf("{{ lower $entity.Name }}_%d", time.Now().UnixNano())
}

{{- range $req.Commands }}
func (p *{{$plugin}}Plugin) {{ lower .Name }}Handler(input *{{ .Name }}Input) ([]eventsourcing.Event, error) {
{{- if eq .Action "create" }}
    event := &{{$entity.Name}}CreatedEvent{
        EventType: "{{$req.Name}}_{{$entity.Name}}Created",
        {{$entityID}}: generate{{$entity.Name}}ID(),
{{- range .Input }}
        {{ .Name }}: input.{{ .Name }},
{{- end }}
    }
    return []eventsourcing.Event{event}, nil
{{- else if eq .Action "update" }}
    p.aggregate.Mu.RLock()
    _, exists := p.aggregate.{{$entity.Name}}s[input.{{$entityID}}]
    p.aggregate.Mu.RUnlock()
    if !exists {
        return nil, fmt.Errorf("{{$entity.Name}} %s not found", input.{{$entityID}})
    }
    event := &{{$entity.Name}}UpdatedEvent{
        EventType: "{{$req.Name}}_{{$entity.Name}}Updated",
{{- range $entity.Fields }}
        {{ .Name }}: input.{{ .Name }},
{{- end }}
    }
    return []eventsourcing.Event{event}, nil
{{- else if eq .Action "delete" }}
    p.aggregate.Mu.RLock()
    _, exists := p.aggregate.{{$entity.Name}}s[input.{{$entityID}}]
    p.aggregate.Mu.RUnlock()
    if !exists {
        return nil, fmt.Errorf("{{$entity.Name}} %s not found", input.{{$entityID}})
    }
    event := &{{$entity.Name}}DeletedEvent{
        EventType: "{{$req.Name}}_{{$entity.Name}}Deleted",
        {{$entityID}}: input.{{$entityID}},
    }
    return []eventsourcing.Event{event}, nil
{{- else if eq .Action "list" }}
    p.aggregate.Mu.RLock()
    items := make([]*{{$entity.Name}}, 0, len(p.aggregate.{{$entity.Name}}s))
    for _, item := range p.aggregate.{{$entity.Name}}s {
        clone := *item
        items = append(items, &clone)
    }
    p.aggregate.Mu.RUnlock()
    sort.Slice(items, func(i, j int) bool {
        return items[i].CreatedAt.Before(items[j].CreatedAt)
    })
    event := &{{$entity.Name}}sListedEvent{EventType: "{{$req.Name}}_{{$entity.Name}}sListed", {{$entity.Name}}s: items}
    return []eventsourcing.Event{event}, nil
{{- else }}
    return nil, fmt.Errorf("unsupported action for command {{ .Name }}")
{{- end }}
}
{{- end }}

func (p *{{$plugin}}Plugin) Aggregate() eventsourcing.Aggregate {
    return p.aggregate
}

func (p *{{$plugin}}Plugin) Type() eventsourcing.PluginType {
    return eventsourcing.LLMPlugin
}

func (p *{{$plugin}}Plugin) SystemPrompt() string {
    p.aggregate.Mu.RLock()
    defer p.aggregate.Mu.RUnlock()

    var state strings.Builder
    if len(p.aggregate.{{$entity.Name}}s) == 0 {
        state.WriteString("There are currently no {{$entity.Name}} records.\n")
    } else {
        state.WriteString("Current {{$entity.Name}} entries:\n")
        for _, item := range p.aggregate.{{$entity.Name}}s {
            state.WriteString(fmt.Sprintf("- {{$entityID}}: %s\n", item.{{$entityID}}))
        }
    }

    prompt := `You are {{$req.Name}}Master, a specialized AI for managing {{$entity.Name}} records in MindPalace.

` + state.String() + `
Always use the provided commands to mutate state and keep responses concise.`

    return prompt
}

